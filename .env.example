# Ecwid app credentials (required)
# This file is committed and deployed with the app (see includeFiles in vercel.json).
# ECWID_CLIENT_SECRET also derives the session-cookie encryption key and the
# Ecwid webhook signature key, so changing it invalidates all active sessions.
ECWID_CLIENT_ID=your_client_id
ECWID_CLIENT_SECRET=your_client_secret

# Server port (optional, default 3001)
PORT=3001

# Optional hardening flags
# Disable the last-resort storefront HTML rule scrape (default: enabled)
# PB_ALLOW_HTML_RULE_SCRAPE=false
# Skip Ecwid webhook signature checks — non-production only, ignored when NODE_ENV=production
# WEBHOOK_SKIP_VERIFY=true
